# Скопируйте в .env для локального запуска (на Render эти значения вносятся в Environment)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...        # публичный anon/publishable ключ
SUPABASE_SERVICE_ROLE_KEY=eyJ... # СЕКРЕТ! только на сервере
ADMIN_LOGIN=admin                # логин главного админа (или e-mail)
ADMIN_PASSWORD=поменяйте-меня    # пароль главного админа
# необязательно: письмо главному админу при "забыл пароль" (resend.com)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
